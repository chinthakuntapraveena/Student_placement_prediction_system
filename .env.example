# =============================================================================
# Environment Configuration & Secrets Management (.env.example)
# Rename to .env and configure your local or cloud database credentials
# =============================================================================

# Database Driver: 'sqlite' or 'mysql'
DB_TYPE=sqlite

# SQLite Path (Used when DB_TYPE=sqlite)
SQLITE_PATH=database/student_placement.db

# MySQL Configuration (Used when DB_TYPE=mysql)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=student_placement_db
DB_USER=root
DB_PASSWORD=your_secure_password_here

# Application Secrets
APP_ENV=production
SECRET_KEY=generate_a_random_sha256_key_for_session_security
